{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "mts:show",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/show"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.rot.x",
          "variable.rot.y",
          "variable.rot.z"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.width",
          "variable.length"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": [
              "v.color.r",
              "v.color.g",
              "v.color.b",
              "v.color.a"
            ],
            "0.2": [
              "v.color.r",
              "v.color.g",
              "v.color.b",
              "v.color.a"
            ],
            "0.21": [
              "v.color.r",
              "v.color.g",
              "v.color.b",
              0
            ]
          }
        }
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.particle_lifetime"
      }
    }
  }
}