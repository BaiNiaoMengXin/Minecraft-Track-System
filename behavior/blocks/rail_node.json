{
  "format_version": "1.21.60",
  "minecraft:block": {
    "description": {
      "identifier": "mts:rail_node",
      "menu_category": {
        "category": "construction"
      },
      "states": {
        "mts:facing": [ false, true ],
        "mts:is_22_5": [ false, true ],
        "mts:is_45": [ false, true ],
        "mts:is_connected": [ false, true ]
      }
    },
    "components": {
      "minecraft:geometry": "geometry.rail_node",
      "minecraft:material_instances": {
        "*": {
          "texture": "rail_node",
          "render_method": "alpha_test"
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 2.0
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 6.0
      },
      "minecraft:collision_box": false,
      "minecraft:friction": 0.6,
      "minecraft:map_color": "#A7A7A7",
      "minecraft:light_dampening": 0
    },
    "permutations": [
      {
        "condition": "query.block_state('mts:is_connected')",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "rail_node_connected",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "!query.block_state('mts:is_connected')",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "rail_node",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "query.block_state('mts:facing')",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "!query.block_state('mts:facing')",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('mts:is_22_5') && query.block_state('mts:is_45')",
        "components": {
          "minecraft:geometry": "geometry.rail_node_67_5"
        }
      },
      {
        "condition": "query.block_state('mts:is_22_5') && !query.block_state('mts:is_45')",
        "components": {
          "minecraft:geometry": "geometry.rail_node_22_5"
        }
      },
      {
        "condition": "!query.block_state('mts:is_22_5') && query.block_state('mts:is_45')",
        "components": {
          "minecraft:geometry": "geometry.rail_node_45"
        }
      },
      {
        "condition": "!query.block_state('mts:is_22_5') && !query.block_state('mts:is_45')",
        "components": {
          "minecraft:geometry": "geometry.rail_node"
        }
      }
    ]
  }
}